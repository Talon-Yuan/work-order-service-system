/* pages/store/store.wxss */
.page { padding: 24rpx 28rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: var(--text); }
.page-hint { margin-top: 12rpx; font-size: 24rpx; color: var(--text-2); }
.part-list { margin-top: 20rpx; }
.part-card { background: var(--card-bg, #141B26); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.part-name { font-size: 32rpx; font-weight: 600; color: var(--text); }
.part-meta { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }
.part-price { margin-top: 8rpx; font-size: 30rpx; color: #FF9F43; font-weight: 700; }
.part-desc { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }
.cart-bar { position: fixed; left: 28rpx; right: 28rpx; bottom: 40rpx; background: #FF9F43; color: #0A0E14; border-radius: 999rpx; padding: 24rpx 40rpx; display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; font-weight: 700; }
.cart-bar-go { font-weight: 700; }
