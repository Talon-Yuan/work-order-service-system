/* pages/dashboard/dashboard.wxss — 数据看板 */
.page { padding: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #F2F4F8; }
.page-hint { font-size: 26rpx; color: #8A93A6; margin-top: 8rpx; }
.kpi-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.kpi-card { flex: 1 1 30%; min-width: 200rpx; background: #141B26; border-radius: 16rpx; padding: 24rpx; display: flex; flex-direction: column; }
.kpi-num { font-size: 44rpx; font-weight: 700; color: #FF9F43; }
.kpi-label { font-size: 24rpx; color: #8A93A6; margin-top: 8rpx; }
.w-card { background: #141B26; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; }
.card-title { font-size: 30rpx; color: #F2F4F8; margin-bottom: 16rpx; }
.status-row, .trend-row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #1E2836; font-size: 28rpx; color: #C6CDD8; }
.status-row:last-child, .trend-row:last-child { border-bottom: none; }
.status-count { color: #FF9F43; font-weight: 600; }
.trend-row.head { color: #8A93A6; font-size: 24rpx; }
.trend-date { flex: 1; }
.trend-cell { width: 120rpx; text-align: right; }
.menu-card { display: flex; justify-content: space-between; align-items: center; background: #141B26; border-radius: 16rpx; padding: 26rpx 28rpx; margin-top: 24rpx; color: #F2F4F8; }
.arrow { color: #8A93A6; }
