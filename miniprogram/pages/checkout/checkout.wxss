/* pages/checkout/checkout.wxss */
.page { padding: 24rpx 28rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: var(--text); }
.page-hint { margin-top: 12rpx; font-size: 24rpx; color: var(--text-2); }
.item-card { background: var(--card-bg, #141B26); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.item-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.item-meta { margin-top: 8rpx; font-size: 24rpx; color: var(--text-2); }
.item-price { margin-top: 8rpx; font-size: 28rpx; color: #FF9F43; font-weight: 700; }
.total-row { display: flex; justify-content: space-between; padding: 24rpx 0; font-size: 30rpx; font-weight: 700; color: var(--text); }
.total-price { color: #FF9F43; }
