/* pages/knowledge/knowledge.wxss — 知识库 */
.page { padding: 24rpx 28rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: var(--text); }
.page-hint { margin-top: 12rpx; font-size: 24rpx; color: var(--text-2); }

.search-row { display: flex; margin-top: 24rpx; }
.search-input { flex: 1; height: 72rpx; padding: 0 20rpx; border-radius: 12rpx; background: rgba(255,255,255,.06); color: var(--text); font-size: 26rpx; }
.search-btn { margin-left: 14rpx; height: 72rpx; line-height: 72rpx; padding: 0 30rpx; border-radius: 12rpx; background: var(--accent, #FF9F43); color: #1A1308; font-size: 26rpx; font-weight: 600; }

.cats { white-space: nowrap; margin-top: 16rpx; }
.cat-chip { display: inline-block; padding: 10rpx 26rpx; margin-right: 12rpx; border-radius: 30rpx; font-size: 24rpx; color: var(--text-2); background: rgba(255,255,255,.06); }
.cat-on { color: #1A1308; background: var(--accent, #FF9F43); }

.admin-bar { display: flex; margin: 20rpx 0 4rpx; }
.admin-btn { padding: 12rpx 28rpx; margin-right: 14rpx; border-radius: 30rpx; font-size: 24rpx; color: var(--accent, #FF9F43); border: 1rpx solid rgba(255,159,67,.4); }

.form-card { margin-top: 20rpx; padding: 24rpx; border-radius: 16rpx; background: var(--card, rgba(255,255,255,.05)); border: 1rpx solid rgba(255,159,67,.3); }
.form-head { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.form-title { font-size: 30rpx; font-weight: 700; color: var(--text); }
.form-close { color: var(--text-2); font-size: 30rpx; padding: 0 8rpx; }
.field { margin-bottom: 18rpx; }
.field-label { display: block; font-size: 24rpx; color: var(--text-2); margin-bottom: 8rpx; }
.field-input { height: 72rpx; padding: 0 20rpx; border-radius: 12rpx; background: rgba(255,255,255,.06); color: var(--text); font-size: 26rpx; }
.field-area { width: 100%; height: 200rpx; padding: 16rpx 20rpx; box-sizing: border-box; border-radius: 12rpx; background: rgba(255,255,255,.06); color: var(--text); font-size: 26rpx; }
.chips { display: flex; flex-wrap: wrap; }
.chip { padding: 8rpx 22rpx; margin: 0 12rpx 10rpx 0; border-radius: 30rpx; font-size: 24rpx; color: var(--text-2); background: rgba(255,255,255,.06); }
.chip-on { color: #1A1308; background: var(--accent, #FF9F43); }
.form-actions { margin-top: 8rpx; }

.empty { padding: 50rpx 0; text-align: center; color: var(--text-2); font-size: 26rpx; }
.kb-card { margin-top: 16rpx; padding: 22rpx; border-radius: 16rpx; background: var(--card, rgba(255,255,255,.04)); }
.kb-head { display: flex; justify-content: space-between; align-items: center; }
.kb-title { flex: 1; font-size: 30rpx; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.kb-vis { margin-left: 12rpx; padding: 4rpx 14rpx; border-radius: 20rpx; font-size: 20rpx; }
.vis-public { color: #2ECC71; background: rgba(46,204,113,.12); }
.vis-internal { color: #FF9F43; background: rgba(255,159,67,.12); }
.kb-meta { margin-top: 12rpx; display: flex; justify-content: space-between; }
.kb-cat { font-size: 22rpx; color: var(--accent, #FF9F43); }
.kb-time { font-size: 22rpx; color: var(--text-3); }
