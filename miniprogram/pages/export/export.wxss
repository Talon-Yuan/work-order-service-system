/* pages/export/export.wxss — 报表导出 */
.page { padding: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #F2F4F8; }
.page-hint { font-size: 26rpx; color: #8A93A6; margin-top: 8rpx; }
.w-card { background: #141B26; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; }
.card-title { font-size: 30rpx; color: #F2F4F8; margin-bottom: 16rpx; }
.type-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.type-chip { padding: 12rpx 22rpx; border-radius: 24rpx; background: #0D121A; color: #8A93A6; font-size: 26rpx; }
.type-chip.active { background: #FF9F43; color: #0D121A; font-weight: 600; }
.form-row { display: flex; align-items: center; padding: 10rpx 0; }
.form-label { width: 220rpx; font-size: 26rpx; color: #C6CDD8; }
.form-input { flex: 1; background: #0D121A; border-radius: 10rpx; padding: 16rpx; color: #F2F4F8; font-size: 28rpx; }
.rec-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #1E2836; }
.rec-main { display: flex; flex-direction: column; flex: 1; margin-right: 12rpx; }
.rec-no { font-size: 28rpx; color: #F2F4F8; }
.rec-sub { font-size: 24rpx; color: #8A93A6; margin-top: 4rpx; }
.rec-link { font-size: 26rpx; color: #FF9F43; }
