<!-- pages/mine/mine.wxml -->
<view class="page">
  <view class="page-title">{i18n.mine}</view>
  <view class="page-hint">{i18n.skeletonHint}</view>
  <w-button text="{i18n.skeletonAction}" bind:tap="onTapDemo" />
  <view class="menu-card" bind:tap="onGoLogistics">
    <text>{i18n.myLogistics}</text><text class="arrow">›</text>
  </view>
  <view class="menu-card" bind:tap="onGoSubscribe">
    <text>{i18n.subscribeManage}</text><text class="arrow">›</text>
  </view>
  <view class="menu-card" bind:tap="onGoDashboard">
    <text>{i18n.dashboardTitle}</text><text class="arrow">›</text>
  </view>
  <view class="menu-card" bind:tap="onGoCost">
    <text>{i18n.costTitle}</text><text class="arrow">›</text>
  </view>
  <view class="menu-card" bind:tap="onGoExport">
    <text>{i18n.exportTitle}</text><text class="arrow">›</text>
  </view>
  <view class="menu-card" bind:tap="onGoReview">
    <text>{i18n.myEvaluation}</text><text class="arrow">›</text>
  </view>
  <view class="menu-card" bind:tap="onGoKnowledge">
    <text>{i18n.myKnowledge}</text><text class="arrow">›</text>
  </view>
</view>
