/* pages/cost/cost.wxss — 成本统计 */
.page { padding: 24rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: #F2F4F8; }
.page-hint { font-size: 26rpx; color: #8A93A6; margin-top: 8rpx; }
.w-card { background: #141B26; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; }
.card-title { font-size: 30rpx; color: #F2F4F8; margin-bottom: 16rpx; }
.big-num { font-size: 56rpx; font-weight: 700; color: #FF9F43; margin-bottom: 12rpx; }
.kv-row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #1E2836; font-size: 28rpx; color: #C6CDD8; }
.kv-row:last-child { border-bottom: none; }
.trend-row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #1E2836; font-size: 26rpx; color: #C6CDD8; }
.trend-row.head { color: #8A93A6; font-size: 24rpx; }
.trend-date { flex: 1; }
.trend-cell { width: 140rpx; text-align: right; }
.top-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #1E2836; }
.top-main { display: flex; flex-direction: column; }
.top-no { font-size: 28rpx; color: #F2F4F8; }
.top-sub { font-size: 24rpx; color: #8A93A6; margin-top: 4rpx; }
.top-amt { font-size: 28rpx; color: #FF9F43; font-weight: 600; }
.form-row { display: flex; align-items: center; padding: 12rpx 0; }
.form-label { width: 300rpx; font-size: 26rpx; color: #C6CDD8; }
.form-input { flex: 1; background: #0D121A; border-radius: 10rpx; padding: 16rpx; color: #F2F4F8; font-size: 28rpx; }
