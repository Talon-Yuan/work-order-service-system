/* pages/review/review.wxss — 服务评价 */
.page { padding: 24rpx 28rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: var(--text); }
.page-hint { margin-top: 12rpx; font-size: 24rpx; color: var(--text-2); }

.stats-card { margin-top: 24rpx; padding: 24rpx; border-radius: 16rpx; background: linear-gradient(135deg, rgba(255,159,67,.16), rgba(255,159,67,.05)); border: 1rpx solid rgba(255,159,67,.28); }
.stats-row { display: flex; justify-content: space-around; margin-bottom: 16rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 52rpx; font-weight: 800; color: var(--accent, #FF9F43); }
.stat-label { font-size: 22rpx; color: var(--text-2); margin-top: 4rpx; }
.stats-dist { display: flex; align-items: center; margin-top: 10rpx; }
.dist-star { width: 80rpx; font-size: 24rpx; color: var(--text); }
.dist-bar { flex: 1; height: 14rpx; background: rgba(255,255,255,.08); border-radius: 8rpx; overflow: hidden; }
.dist-fill { height: 100%; background: var(--accent, #FF9F43); border-radius: 8rpx; }
.dist-count { width: 70rpx; text-align: right; font-size: 24rpx; color: var(--text-2); }

.form-card { margin-top: 24rpx; padding: 24rpx; border-radius: 16rpx; background: var(--card, rgba(255,255,255,.04)); }
.field { margin-bottom: 20rpx; }
.field-label { display: block; font-size: 26rpx; color: var(--text-2); margin-bottom: 8rpx; }
.field-input { height: 72rpx; padding: 0 20rpx; border-radius: 12rpx; background: rgba(255,255,255,.06); color: var(--text); font-size: 28rpx; }
.field-area { width: 100%; height: 140rpx; padding: 16rpx 20rpx; box-sizing: border-box; border-radius: 12rpx; background: rgba(255,255,255,.06); color: var(--text); font-size: 26rpx; }
.stars { display: flex; }
.star { font-size: 56rpx; color: rgba(255,255,255,.15); margin-right: 12rpx; }
.star-on { color: #FFB020; }
.tags { display: flex; flex-wrap: wrap; }
.tag { padding: 8rpx 20rpx; margin: 0 12rpx 12rpx 0; border-radius: 30rpx; font-size: 24rpx; color: var(--text-2); background: rgba(255,255,255,.06); }
.tag-on { color: #1A1308; background: var(--accent, #FF9F43); }
.form-hint { font-size: 22rpx; color: var(--text-3); margin-bottom: 16rpx; }

.list-title { margin: 28rpx 0 12rpx; font-size: 30rpx; font-weight: 700; color: var(--text); }
.empty { padding: 40rpx 0; text-align: center; color: var(--text-2); font-size: 26rpx; }
.eval-card { margin-top: 16rpx; padding: 20rpx; border-radius: 16rpx; background: var(--card, rgba(255,255,255,.04)); }
.eval-head { display: flex; justify-content: space-between; }
.eval-rating { font-size: 32rpx; font-weight: 700; color: #FFB020; }
.eval-time { font-size: 22rpx; color: var(--text-3); }
.eval-tags { margin-top: 10rpx; }
.mini-tag { display: inline-block; padding: 4rpx 16rpx; margin-right: 10rpx; border-radius: 20rpx; font-size: 22rpx; color: var(--text-2); background: rgba(255,255,255,.06); }
.eval-content { margin-top: 10rpx; font-size: 26rpx; color: var(--text); line-height: 1.6; }
