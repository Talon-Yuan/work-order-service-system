/* pages/orders/orders.wxss */
.page { padding: 24rpx 28rpx; }
.page-title { font-size: 40rpx; font-weight: 700; color: var(--text); }
.page-hint { margin-top: 12rpx; font-size: 24rpx; color: var(--text-2); }
.order-card { background: var(--card-bg, #141B26); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.order-head { display: flex; justify-content: space-between; align-items: center; }
.order-no { font-size: 26rpx; color: var(--text-2); }
.order-status { font-size: 28rpx; font-weight: 700; color: #FF9F43; }
.order-item { display: flex; justify-content: space-between; margin-top: 16rpx; font-size: 28rpx; color: var(--text); }
.order-foot { display: flex; justify-content: space-between; margin-top: 16rpx; font-size: 24rpx; color: var(--text-2); }
.order-total { font-size: 30rpx; font-weight: 700; color: #FF9F43; }
.order-actions { margin-top: 20rpx; }
