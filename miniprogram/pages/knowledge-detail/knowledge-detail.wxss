/* pages/knowledge-detail/knowledge-detail.wxss — 知识详情 */
.page { padding: 24rpx 28rpx; }
.back-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.back-arrow { font-size: 40rpx; color: var(--text-2); margin-right: 8rpx; }
.back-text { font-size: 26rpx; color: var(--text-2); }

.detail-card { padding: 24rpx; border-radius: 16rpx; background: var(--card, rgba(255,255,255,.04)); }
.d-head { display: flex; justify-content: space-between; align-items: center; }
.d-title { flex: 1; font-size: 34rpx; font-weight: 700; color: var(--text); line-height: 1.4; }
.kb-vis { margin-left: 12rpx; padding: 4rpx 14rpx; border-radius: 20rpx; font-size: 20rpx; }
.vis-public { color: #2ECC71; background: rgba(46,204,113,.12); }
.vis-internal { color: #FF9F43; background: rgba(255,159,67,.12); }
.d-meta { margin-top: 10rpx; display: flex; justify-content: space-between; }
.d-cat { font-size: 22rpx; color: var(--accent, #FF9F43); }
.d-time { font-size: 22rpx; color: var(--text-3); }
.internal-hint { margin-top: 14rpx; padding: 12rpx 16rpx; border-radius: 10rpx; font-size: 22rpx; color: #FF9F43; background: rgba(255,159,67,.1); }
.d-content { margin-top: 20rpx; font-size: 28rpx; color: var(--text); line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.d-ops { display: flex; margin-top: 28rpx; }
.op-btn { padding: 12rpx 32rpx; margin-right: 14rpx; border-radius: 30rpx; font-size: 24rpx; color: var(--accent, #FF9F43); border: 1rpx solid rgba(255,159,67,.4); }
.op-danger { color: #E5484D; border-color: rgba(229,72,77,.4); }
.op-plain { color: var(--text-2); border-color: rgba(255,255,255,.15); margin-top: 16rpx; }

.form-card { margin-top: 20rpx; padding: 24rpx; border-radius: 16rpx; background: var(--card, rgba(255,255,255,.05)); border: 1rpx solid rgba(255,159,67,.3); }
.field { margin-bottom: 18rpx; }
.field-label { display: block; font-size: 24rpx; color: var(--text-2); margin-bottom: 8rpx; }
.field-input { height: 72rpx; padding: 0 20rpx; border-radius: 12rpx; background: rgba(255,255,255,.06); color: var(--text); font-size: 26rpx; }
.field-area { width: 100%; height: 260rpx; padding: 16rpx 20rpx; box-sizing: border-box; border-radius: 12rpx; background: rgba(255,255,255,.06); color: var(--text); font-size: 26rpx; }
.chips { display: flex; flex-wrap: wrap; }
.chip { padding: 8rpx 22rpx; margin: 0 12rpx 10rpx 0; border-radius: 30rpx; font-size: 24rpx; color: var(--text-2); background: rgba(255,255,255,.06); }
.chip-on { color: #1A1308; background: var(--accent, #FF9F43); }
.form-actions { margin-top: 8rpx; }
