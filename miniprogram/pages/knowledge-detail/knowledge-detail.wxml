<!-- pages/knowledge-detail/knowledge-detail.wxml — 知识详情（阶段8-3） -->
<view class="page">
  <view class="back-row" bind:tap="onBack">
    <text class="back-arrow">‹</text><text class="back-text">{{i18n.kbBack}}</text>
  </view>

  <block wx:if="{{article}}">
    <view class="detail-card">
      <view class="d-head">
        <text class="d-title">{{article.title}}</text>
        <text class="kb-vis vis-{{article.visibility}}">{{article.vis_label}}</text>
      </view>
      <view class="d-meta">
        <text class="d-cat">{{article.cat_label}} · {{article.status_label}}</text>
        <text class="d-time">{{i18n.kbViewCount}} {{article.view_count}}</text>
      </view>
      <view class="d-meta" wx:if="{{article.published_text}}">
        <text class="d-time">{{i18n.kbPublishedAt}} {{article.published_text}}</text>
      </view>
      <view class="internal-hint" wx:if="{{article.visibility === 'internal'}}">{{i18n.kbInternalOnly}}</view>
      <view class="d-content">{{article.content}}</view>
      <view class="d-ops">
        <view class="op-btn" bind:tap="onEdit">{{i18n.kbEdit}}</view>
        <view class="op-btn op-danger" bind:tap="onDelete">{{i18n.kbDelete}}</view>
      </view>
    </view>
  </block>

  <!-- 编辑面板 -->
  <view class="form-card" wx:if="{{editing}}">
    <view class="field">
      <text class="field-label">{{i18n.kbCreateTitle}}</text>
      <input class="field-input" value="{{form.title}}" bindinput="onFTitle" maxlength="120" />
    </view>
    <view class="field">
      <text class="field-label">{{i18n.kbCategory}}</text>
      <view class="chips">
        <text wx:for="{{catOptions}}" wx:key="key"
          class="chip {{form.category === item.key ? 'chip-on' : ''}}"
          data-key="{{item.key}}" bind:tap="onFCategory">{{item.label}}</text>
      </view>
    </view>
    <view class="field">
      <text class="field-label">{{i18n.kbVisibility}}</text>
      <view class="chips">
        <text wx:for="{{visOptions}}" wx:key="key"
          class="chip {{form.visibility === item.key ? 'chip-on' : ''}}"
          data-key="{{item.key}}" bind:tap="onFVisibility">{{item.label}}</text>
      </view>
    </view>
    <view class="field">
      <text class="field-label">{{i18n.kbStatus}}</text>
      <view class="chips">
        <text wx:for="{{statusOptions}}" wx:key="key"
          class="chip {{form.status === item.key ? 'chip-on' : ''}}"
          data-key="{{item.key}}" bind:tap="onFStatus">{{item.label}}</text>
      </view>
    </view>
    <view class="field">
      <text class="field-label">{{i18n.kbContent}}</text>
      <textarea class="field-area" value="{{form.content}}" bindinput="onFContent" maxlength="8000" />
    </view>
    <view class="form-actions">
      <w-button text="{{i18n.kbSave}}" bind:tap="onSave" />
      <view class="op-btn op-plain" bind:tap="onCancelEdit">{{i18n.cancel}}</view>
    </view>
  </view>
</view>
